{
  "name": "omp-qol-plugin",
  "version": "0.3.2",
  "description": "Quality-of-life plugin for the omp (Oh My Pi) coding agent: agent goal tool + agent-controlled plan/vibe modes + agent-facing advisor (WATCHDOG) management",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/RatmmmhSquishyRat/omp-qol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RatmmmhSquishyRat/omp-qol.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/RatmmmhSquishyRat/omp-qol/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.plugin.json",
    "typecheck:host": "tsc --noEmit"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "plugin",
    "coding-agent",
    "qol"
  ],
  "omp": {
    "extensions": [
      "./src/main.ts"
    ],
    "settings": {
      "greeting": {
        "type": "string",
        "default": "omp-qol ready.",
        "description": "Notification text shown when a session starts"
      },
      "notifyOnSessionStart": {
        "type": "boolean",
        "default": true,
        "description": "Show the greeting notification on session start"
      },
      "goalToolEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Register the always-available agent goal tool (QOL-001)"
      },
      "modeToolEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Register the agent-controlled plan/vibe mode tool (QOL-002/003)"
      },
      "advisorToolEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Register the agent-facing advisor tool (QOL-004)"
      }
    }
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0",
    "zod": "4.4.3"
  }
}
